{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @lucky-moment/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/lucky-moment", "destination": "/index.html" },
    { "source": "/lucky-moment/", "destination": "/index.html" },
    { "source": "/lucky-moment/:path*", "destination": "/:path*" }
  ]
}
