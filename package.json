{
  "name": "lucky-moment",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "concurrently -k -n backend,web -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @lucky-moment/web dev",
    "dev:backend": "pnpm --filter @lucky-moment/backend dev",
    "build": "pnpm --filter @lucky-moment/web build && pnpm --filter @lucky-moment/backend build",
    "start": "pnpm --filter @lucky-moment/backend start",
    "typecheck": "pnpm --filter @lucky-moment/web typecheck && pnpm --filter @lucky-moment/backend typecheck",
    "test": "tsx --test apps/web/src/module/lottery/lotteryState.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
